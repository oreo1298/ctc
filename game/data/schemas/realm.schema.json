{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realm.schema.json",
  "title": "Realm: an ordered set of levels with a shared look",
  "type": "object",
  "required": ["$schema", "id", "name", "order", "levels", "palette", "backdrop"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string"},
    "tagline": {"type": "string"},
    "order": {"type": "integer", "minimum": 1},
    "levels": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "palette": {
      "type": "object",
      "required": ["ink", "paper", "ground_top", "ground", "ground_deep", "far", "mid", "near", "accent"],
      "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "backdrop": {
      "type": "object",
      "required": ["layers", "props"],
      "additionalProperties": false,
      "properties": {
        "layers": {"type": "integer", "minimum": 1, "maximum": 8},
        "roughness": {"type": "number", "minimum": 0},
        "props": {"enum": ["trees", "cacti", "pines", "none"]}
      }
    }
  }
}
