msgstr ""

#: data/levels/cinderreach/cinderreach-02.json
msgid "The Ash Pharaoh's steps lead up to his throne. Rearrange them so they lead down."
msgstr ""

#: data/levels/mirefen/mirefen-12.json
msgid "The Bog King says Mirefen Hall is unsinkable. It is built on a swamp. Test that."
msgstr ""

#: data/levels/frostfang/frostfang-10.json
msgid "The Bridge"
msgstr ""

#: data/levels/frostfang/frostfang-10.json
msgid "The Bridge Lord charges me a toll. A toll! Me!"
msgstr ""

#: data/levels/cinderreach/cinderreach-11.json
msgid "The Brothers Ashcroft live on two volcanoes and shout at each other across the lava. Settle it."
msgstr ""

#: data/levels/greenmantle/greenmantle-11.json
msgid "The Brothers Hale each built a keep. Two insults for the price of one."
msgstr ""

#: data/levels/saffron/saffron-10.json
msgid "The Caliph's oasis has fountains. My well has frogs."
