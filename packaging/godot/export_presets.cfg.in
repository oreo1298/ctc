exclude_filter="tests/*, tools/*, addons/gut/*, data/levels/dev/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.1.options]

custom_template/debug="@TEMPLATES@/linux_debug.arm64"
custom_template/release="@TEMPLATES@/linux_release.arm64"
debug/export_console_wrapper=0
binary_format/embed_pck=@EMBED_PCK@
texture_format/s3tc_bptc=false
texture_format/etc2_astc=true
binary_format/architecture="arm64"

[preset.2]

name="Windows x86_64"
platform="Windows Desktop"
runnable=false
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="tests/*, tools/*, addons/gut/*, data/levels/dev/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.2.options]

custom_template/debug="@TEMPLATES@/windows_debug_x86_64.exe"
custom_template/release="@TEMPLATES@/windows_release_x86_64.exe"
debug/export_console_wrapper=0
binary_format/embed_pck=@EMBED_PCK@
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
binary_format/architecture="x86_64"
codesign/enable=false
application/modify_resources=true
application/icon="@ICON_ICO@"
application/console_wrapper_icon=""
application/icon_interpolation=4
application/file_version="@VERSION_NUM@.0"
application/product_version="@VERSION_NUM@.0"
application/company_name="@APP_DEVELOPER@"
application/product_name="@APP_NAME@"
application/file_description="@APP_NAME@"
application/copyright="© @YEAR@ @APP_DEVELOPER@ (MIT code, CC BY-SA 4.0 art)"
application/trademarks=""
application/export_angle=0
application/export_d3d12=0

[preset.3]

name="iOS"
platform="iOS"
runnable=false
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="tests/*, tools/*, addons/gut/*, data/levels/dev/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.3.options]

custom_template/debug="@TEMPLATES@/ios.zip"
custom_template/release="@TEMPLATES@/ios.zip"
architectures/arm64=true
application/export_project_only=true
application/app_store_team_id="@IOS_TEAM_ID@"
application/export_method_debug=1
application/export_method_release=1
application/code_sign_identity_debug=""
application/code_sign_identity_release=""
application/provisioning_profile_uuid_debug=""
application/provisioning_profile_uuid_release=""
application/bundle_identifier="@APP_ID@"
application/signature=""
application/short_version="@VERSION_NUM@"
application/version="@VERSION_NUM@"
application/targeted_device_family=2
application/min_ios_version="16.0"
application/additional_plist_content=""
application/icon_interpolation=4
application/delete_old_export_files_unconditionally=true
capabilities/access_wifi=false
capabilities/performance_gaming_tier=false
user_data/accessible_from_files_app=true
user_data/accessible_from_itunes_sharing=true
icons/icon_1024x1024="@ICON_1024@"
storyboard/image_scale_mode=0
storyboard/use_custom_bg_color=true
storyboard/custom_bg_color=Color(0.953, 0.918, 0.835, 1)
texture_format/s3tc_bptc=false
texture_format/etc2_astc=true
