;
; Template for game/export_presets.cfg, rendered by scripts/build.sh from
; app.env and toolchain.lock (the rendered file is not committed). Templates
; are given as absolute custom_template paths, so exports never depend on
; where the Godot editor keeps its own template folder.

[preset.0]

name="Linux x86_64"
platform="Linux"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="tests/*, tools/*, addons/gut/*, data/levels/dev/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug="@TEMPLATES@/linux_debug.x86_64"
custom_template/release="@TEMPLATES@/linux_release.x86_64"
debug/export_console_wrapper=0
binary_format/embed_pck=@EMBED_PCK@
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
binary_format/architecture="x86_64"

