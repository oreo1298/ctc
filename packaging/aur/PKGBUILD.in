# Maintainer: @APP_DEVELOPER@ <@APP_CONTACT@>
# Generated by scripts/package.sh aur from packaging/aur/PKGBUILD.in.
#
# Builds from source with the exact Godot release the game is pinned to
# (official binaries, SHA-512 checked). The export templates archive is
# large (about 1.3 GB); only the Linux template for your architecture is
# unpacked from it.
pkgname=@APP_SLUG@
pkgver=@APP_VERSION@
pkgrel=1
pkgdesc="@APP_SUMMARY@"
arch=('x86_64' 'aarch64')
url="@APP_HOMEPAGE@"
license=('MIT' 'CC-BY-SA-4.0' 'OFL-1.1')
depends=('glibc' 'libglvnd' 'alsa-lib' 'libxkbcommon' 'hicolor-icon-theme')
makedepends=('git' 'unzip' 'python')
optdepends=('libpulse: PulseAudio or PipeWire-Pulse sound'
            'vulkan-icd-loader: Vulkan renderer (falls back to OpenGL)'
            'wayland: native Wayland window'
            'libdecor: window decorations on Wayland'
            'libx11: X11 window'
            'libxcursor: X11 cursors'
            'libxinerama: X11 multi-monitor'
            'libxrandr: X11 display modes'
            'libxi: X11 input'
            'fontconfig: system fonts for text not in the bundled fonts'
            'dbus: screensaver inhibition'
            'systemd-libs: gamepad hotplug')
provides=('@APP_SLUG@')
conflicts=('@APP_SLUG@-bin')
options=('!strip' '!debug')
_godot=@GODOT_TAG@
source=("${pkgname}::@SOURCE_GIT@"
        "godot-${_godot}-export-templates.tpz::@GODOT_RELEASE_URL@/Godot_v${_godot}_export_templates.tpz"
        "godot-rapier-@RAPIER_VERSION@.zip::@RAPIER_URL@")
source_x86_64=("godot-${_godot}-linux.x86_64.zip::@GODOT_RELEASE_URL@/Godot_v${_godot}_linux.x86_64.zip")
source_aarch64=("godot-${_godot}-linux.arm64.zip::@GODOT_RELEASE_URL@/Godot_v${_godot}_linux.arm64.zip")
noextract=("godot-${_godot}-export-templates.tpz" "godot-rapier-@RAPIER_VERSION@.zip")
sha512sums=('SKIP'
            '@GODOT_SHA512_TEMPLATES@'
            'SKIP')
sha256sums=('SKIP'
            'SKIP'
            '@RAPIER_SHA256@')
sha512sums_x86_64=('@GODOT_SHA512_LINUX_X86_64@')
sha512sums_aarch64=('@GODOT_SHA512_LINUX_ARM64@')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

build() {
  local garch="${CARCH/aarch64/arm64}"
  # Keep Godot's settings and caches inside the build folder.
  export HOME="${srcdir}/home" XDG_DATA_HOME="${srcdir}/home/data"
  export XDG_CONFIG_HOME="${srcdir}/home/config" XDG_CACHE_HOME="${srcdir}/home/cache"
  mkdir -p "${HOME}" "${srcdir}/templates"
  bsdtar -xf "${srcdir}/godot-${_godot}-export-templates.tpz" -C "${srcdir}" \
    "templates/linux_release.${garch}"
  cd "${srcdir}/${pkgname}"
  bash -ec 'source scripts/lib/common.sh; load_identity; install_rapier_addon game/addons "$1"' \
    _ "${srcdir}/godot-rapier-@RAPIER_VERSION@.zip"
  ./scripts/build.sh --target "linux-${garch}" \
    --godot "${srcdir}/Godot_v${_godot}_linux.${garch}" --templates "${srcdir}/templates"
}

package() {
  cd "${srcdir}/${pkgname}"
  ./scripts/install.sh --prefix /usr --destdir "${pkgdir}" --arch "${CARCH/aarch64/arm64}"
}
