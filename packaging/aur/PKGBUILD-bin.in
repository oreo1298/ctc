# Maintainer: @APP_DEVELOPER@ <@APP_CONTACT@>
# Generated by scripts/package.sh aur from packaging/aur/PKGBUILD-bin.in.
pkgname=@APP_SLUG@-bin
pkgver=@VERSION_PACMAN@
_ver=@APP_VERSION@
pkgrel=1
pkgdesc="@APP_SUMMARY@ (prebuilt)"
arch=('x86_64' 'aarch64')
url="@APP_HOMEPAGE@"
license=('MIT' 'CC-BY-SA-4.0' 'OFL-1.1')
depends=('glibc' 'libglvnd' 'alsa-lib' 'libxkbcommon' 'hicolor-icon-theme')
optdepends=('libpulse: PulseAudio or PipeWire-Pulse sound'
            'vulkan-icd-loader: Vulkan renderer (falls back to OpenGL)'
            'wayland: native Wayland window'
            'libdecor: window decorations on Wayland'
            'libx11: X11 window'
            'libxcursor: X11 cursors'
            'libxinerama: X11 multi-monitor'
            'libxrandr: X11 display modes'
            'libxi: X11 input'
            'fontconfig: system fonts for text not in the bundled fonts'
            'dbus: screensaver inhibition'
            'systemd-libs: gamepad hotplug')
provides=('@APP_SLUG@')
conflicts=('@APP_SLUG@')
# The game data is appended to the executable: never strip it.
options=('!strip' '!debug')
source_x86_64=("@SOURCE_X86_64@")
source_aarch64=("@SOURCE_ARM64@")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local garch="${CARCH/aarch64/arm64}"
  cd "${srcdir}/@APP_SLUG@-${_ver}-linux-${garch}"
  ./scripts/install.sh --prefix /usr --destdir "${pkgdir}" --arch "${garch}"
}
