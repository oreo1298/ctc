#
# THE single source of truth for the game's identity.
# Everything else (project.godot, .desktop, AppStream metainfo, Flatpak
# manifest, PKGBUILDs, spec files, NSIS script, CI artifact names) is
# generated from or checked against this file by scripts/sync-identity.sh.
#
# To rename the game: edit the values below, then run `make sync-identity`.
# The repository itself is NOT renamed by any script.

# Human-facing name (window title, menus, store listings).
APP_NAME="Siegefall"
# Reverse-DNS application ID (Flatpak, AppStream, .desktop file name).
APP_ID="io.github.oreo1298.Siegefall"
# Lower-case machine name: binary, package, data and config directory names.
APP_SLUG="siegefall"
# One-line summary used by .desktop / AppStream / package managers.
APP_SUMMARY="Fling a trebuchet at petty kings' castles"
# Semantic version of the game (not of Godot).
APP_VERSION="0.1.0"
APP_HOMEPAGE="https://github.com/oreo1298/ctc"
APP_DEVELOPER="Siegefall contributors"
APP_DEVELOPER_ID="io.github.oreo1298"
# Contact address for package metadata (deb Maintainer, rpm changelog,
# PKGBUILD). A GitHub no-reply address; packagers may use their own.
APP_CONTACT="oreo1298@users.noreply.github.com"
